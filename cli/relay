def parse_jira(raw, base=None):
    """The Jira key in a pasted URL (?selectedIssue=, /browse/, or anywhere) or a bare
    key, as js/model.js parseJira: {key, url, base}. A bare key's url comes from base."""
    s = (raw or "").strip()
    if not s:
        return None
    k = r"([A-Za-z][A-Za-z0-9_]+-\d+)"
    m = re.search(r"[?&]selectedIssue=" + k, s) or re.search("/browse/" + k, s) or re.search(r"\b" + k + r"\b", s)
    if not m:
        return None
    key = m.group(1).upper()
    if re.match(r"^https?://", s, re.IGNORECASE):
        o = re.match(r"^(https?://[^/?#]+)", s, re.IGNORECASE)
        return {"key": key, "url": s, "base": o.group(1) + "/browse/" if o else None}
    return {"key": key, "url": base + key if base else None, "base": base}


def jira_project_key(prefix):
    """A Jira prefix may contain '_' or run past 10 characters; a Relay project key may not."""
    k = re.sub(r"[^A-Z0-9]", "", (prefix or "").upper())[:10]
    if not re.match(r"^[A-Z]", k):
        k = ("J" + k)[:10]
    if len(k) < 2:
        k = (k + "J")[:10]
    return k


def cmd_jira(args):
    sid = session_id(args)
    t = full_target(args, sid)
    v = common_vars(sid)
    v.update({"tid": t["id"], "newproj": "", "pname": "", "base": "", "colour": JIRA_COLOUR})
    if args.remove:
        if not t.get("jira_key"):
            print("%s has no Jira link." % t["key"])
            return
        v.update({"jkey": "", "jurl": "", "pkey": "", "body": "Removed Jira link."})
        r = q(SQL_JIRA, v, dry_run=args.dry_run)
        print("%sRemoved the Jira link from %s: now %s." % ("Dry run (nothing saved): " if args.dry_run else "",
                                                           t["key"], r["key"]))
        return
    if not args.link:
        raise RelayError("pass the Jira issue URL or key, or --remove")
    projects = q(SQL_PROJECTS) or []
    cur = next((p for p in projects if p["id"] == t["project_id"]), {})
    if cur.get("kind") != "jira" and cur.get("key") != "INB":
        # As in the app: only Jira and Inbox tickets take a Jira link; apps never go into Jira.
        raise RelayError("%s is in app project %s, and app tickets never go into Jira. Only tickets in a "
                         "Jira project or the Inbox take a Jira link." % (t["key"], cur.get("key")))
    prefix_guess = parse_jira(args.link)
    if not prefix_guess or not JIRA_KEY_RE.match(prefix_guess["key"]):
        raise RelayError("no Jira key in %r: pass the issue URL or a key like WEB-500" % args.link)
    prefix = prefix_guess["key"].rsplit("-", 1)[0]
    pkey = jira_project_key(prefix)
    proj = next((p for p in projects if p["key"] == pkey), None)
    j = parse_jira(args.link, (proj or {}).get("jira_base"))
    if proj and proj["kind"] != "jira":
        raise RelayError("%s is an app project, so it can't take a Jira link" % pkey)
    if not proj and not PROJECT_KEY_RE.match(pkey):
        raise RelayError("%s can't be used as a Relay project key" % prefix)
    if t.get("jira_key") == j["key"] and (t.get("jira_url") or "") == (j["url"] or t.get("jira_url") or ""):
        print("%s is already linked to %s." % (t["auto_key"], j["key"]))
        return
    moved = ""
    if not proj:
        moved += " Created Jira project %s." % pkey
        v.update({"newproj": "1", "pname": prefix, "base": j.get("base") or ""})
    if not proj or proj["id"] != t["project_id"]:
        if t.get("parent_id"):
            raise RelayError("%s belongs to project %s, and a phase can't move project without its parent"
                             % (j["key"], pkey))
        moved += " Moved to %s%s." % (pkey, " with its phases" if t.get("children") else "")
    v.update({"jkey": j["key"], "jurl": j.get("url") or t.get("jira_url") or "", "pkey": pkey,
              "body": "Linked Jira %s. Display ID is now %s.%s" % (j["key"], j["key"], moved)})
    r = q(SQL_JIRA, v, dry_run=args.dry_run)
    msg = "Linked %s to %s (its own ID: %s).%s" % (t["key"], j["key"], r["auto_key"], moved)
    if r.get("shared"):
        msg += " %s is also linked to %s." % (j["key"], ", ".join(r["shared"]))
    if not v["jurl"]:
        msg += " No Jira URL known for %s yet: pass the full issue URL to make it a link." % pkey
    print(("Dry run (nothing saved): " if args.dry_run else "") + msg)


