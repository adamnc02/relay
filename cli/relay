def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if IS_WIN and not sys.flags.utf8_mode and not os.environ.get("RELAY_NO_REEXEC"):
        # Started without -X utf8 (e.g. `python relay.py …` by hand): run again in UTF-8
        # mode, or briefs, skills and transcripts are read and written in the ANSI code page.
        env = dict(os.environ, RELAY_NO_REEXEC="1")
        return subprocess.run([sys.executable, "-X", "utf8", os.path.abspath(__file__)] + argv, env=env).returncode
    if argv and argv[0] == "hook":
        return run_hook(argv[1:])
    if not argv or argv[0] == "help":
        build_parser().print_help()
        return 0
    args = build_parser().parse_args(argv)
    if not getattr(args, "fn", None):
        build_parser().print_help()
        return 0
    try:
        return args.fn(args) or 0
    except DBError as e:
        sys.stderr.write("relay: %s\n" % explain_db(e))
        return 1
    except RelayError as e:
        sys.stderr.write("relay: %s\n" % e)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
