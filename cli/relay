def norm_key(key):
    k = (key or "").strip().upper().rstrip(".")
    if not KEY_RE.match(k):
        raise RelayError("%r is not a ticket ID (like RLY-5 or WEB-R12)" % key)
    return k


def resolve(key):
    t = q(SQL_RESOLVE, {"key": norm_key(key)})
    if not t:
        raise RelayError("no ticket %s" % norm_key(key))
    return t


def target(args, sid):
    """The ticket a command acts on: --key, else this session's current ticket."""
    key = getattr(args, "key", None)
    if key:
        return resolve(key)
    cur = current_ticket(load_state(sid))
    if not cur:
        raise RelayError("no ticket attached to this session: pass --key KEY or run `relay attach KEY`")
    return cur


def remember(sid, ticket, cwd=None):
    """Record session -> ticket locally (the current ticket is the last one attached)."""
    def put(s):
        lst = [x for x in (s.get("tickets") or []) if x.get("id") != ticket["id"]]
        lst.append({"id": ticket["id"], "key": ticket["key"], "at": time.time()})
        s["tickets"] = lst
        s.setdefault("cwd", cwd or os.getcwd())
        s.pop("ended", None)
    return update_state(sid, put)


def read_text_arg(value, label_):
    if value == "-":
        data = sys.stdin.read()
        if not data.strip():
            raise RelayError("%s: nothing on stdin" % label_)
        return data
    return value


def do_attach(key, sid, cwd):
    v = common_vars(sid, cwd)
    v["key"] = norm_key(key)
    t = q(SQL_ATTACH, v)
    if not t:
        raise RelayError("no ticket %s" % v["key"])
    remember(sid, t, cwd)
    roots = snapshot_targets(cwd, project={"key": t.get("project"), "paths": t.get("project_paths") or []})
    add_snapshots(sid, roots)
    return t


