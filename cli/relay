def find_psql():
    exe = os.environ.get("RELAY_PSQL") or shutil.which("psql")
    if exe:
        return exe
    for p in psql_candidates():
        if os.path.exists(p):
            return p
    raise DBError("psql not found")


def psql_candidates():
    if not IS_WIN:
        return ("/opt/homebrew/bin/psql", "/usr/local/bin/psql", "/opt/homebrew/opt/libpq/bin/psql",
                "/usr/local/opt/libpq/bin/psql", "/Applications/Postgres.app/Contents/Versions/latest/bin/psql")
    # The EDB installer puts each version in its own folder; newest first.
    found = []
    for base in (os.environ.get("ProgramFiles") or r"C:\Program Files",
                 os.environ.get("LOCALAPPDATA") and os.path.join(os.environ["LOCALAPPDATA"], "Programs")):
        root = os.path.join(base or "", "PostgreSQL")
        try:
            vers = os.listdir(root)
        except OSError:
            continue
        for v in vers:
            found.append((_ver_key(v), os.path.join(root, v, "bin", "psql.exe")))
    return [p for _, p in sorted(found, reverse=True)]


def _ver_key(v):
    return tuple(int(x) if x.isdigit() else 0 for x in re.split(r"[.\-]", v))


PSQL_HINT = ("install PostgreSQL's command-line tools: run the EDB installer from "
             "https://www.postgresql.org/download/windows/ and tick only \"Command Line Tools\""
             if IS_WIN else "install it: brew install libpq && brew link --force libpq")


def psql_quote(v):
    """Quote a value as a single-quoted psql meta-command argument (one line;
    no variable or backquote expansion happens inside the quotes)."""
    if "\0" in v:
        raise ValueError("values can't contain a NUL character")
    return "'" + (v.replace("\\", "\\\\").replace("'", "\\'").replace("\r", "\\r")
                  .replace("\n", "\\n").replace("\t", "\\t")) + "'"


# What each psql variable is called on the command line, for error messages.
FIELD_LABELS = {"title": "the title", "brief": "the brief", "need": "--need", "next": "--next-step",
                "body": "the note", "summary": "--summary", "open": "--open-items", "name": "--name",
                "url": "the URL", "label": "--label", "path": "the path", "q": "the search text"}


def check_value(name, v):
    """Refuse a value psql can't carry, naming the field, line, column and character:
    a NUL, or a byte that wasn't valid UTF-8 (read as a lone surrogate)."""
    for i, ch in enumerate(v):
        bad = None
        if ch == "\0":
            bad = "a NUL character (U+0000)"
        elif "\ud800" <= ch <= "\udfff":
            b = ord(ch) - 0xDC00 if ch >= "\udc80" else None
            bad = ("the byte 0x%02X, which isn't valid UTF-8 (was the text saved in another encoding, "
                   "such as Windows-1252?)" % b) if b is not None and b >= 0x80 else \
                "an unpaired surrogate (U+%04X)" % ord(ch)
        if bad:
            line = v.count("\n", 0, i) + 1
            col = i - (v.rfind("\n", 0, i) + 1) + 1
            raise DBError("%s has %s at line %d, column %d. Nothing was saved." % (
                FIELD_LABELS.get(name, name), bad, line, col), "22021")


def psql(sql, variables=None, timeout=None, dry_run=False):
    """Run SQL (read from stdin by psql, so :'name' variables interpolate) and
    return stdout. Every value goes in as a psql variable, never into the SQL."""
    timeout = timeout if timeout is not None else remaining(20.0)
    ct = max(2, min(5, int(timeout)))
    conn = os.environ.get("RELAY_CONNINFO", CONNINFO_DEFAULT) + \
        " connect_timeout=%d application_name=relay-cli" % ct
    cmd = [find_psql(), "-X", "-w", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1",
           "-v", "VERBOSITY=verbose", "-1", "-d", conn, "-f", "-"]
    # Values go in as \set lines on stdin, never as -v arguments: on Windows psql
    # gets its argv in the ANSI code page, so an en dash arrives as a lone 0x96
    # byte, psql can't quote it, leaves :'name' in the SQL and the server reports
    # 42601 (and characters outside the code page silently become "?").
    sets = []
    for k, v in sorted((variables or {}).items()):
        if not re.match(r"^[a-z_][a-z0-9_]*$", k):
            raise ValueError("bad psql variable name %r" % k)
        v = "" if v is None else str(v)
        check_value(k, v)
        sets.append("\\set %s %s\n" % (k, psql_quote(v)))
    if dry_run:
        # Everything runs, triggers and rules included, then rolls back.
        cmd.remove("-1")
        sql = "begin;\n" + sql.rstrip().rstrip(";") + ";\nrollback;\n"
    sql = "".join(sets) + sql
    env = dict(os.environ)
    env.setdefault("PGPASSFILE", norm("~/.pgpass"))
    env["PGCONNECT_TIMEOUT"] = str(ct)
    env["PGCLIENTENCODING"] = "UTF8"
    try:
        r = subprocess.run(cmd, input=sql, capture_output=True, text=True, encoding="utf-8",
                           errors="replace", timeout=timeout, env=env, **NO_WINDOW)
    except subprocess.TimeoutExpired:
        raise DBError("Relay did not answer within %.1fs" % timeout)
    if r.returncode != 0:
        err = r.stderr or ""
        m = re.search(r"ERROR:\s+([0-9A-Z]{5}):\s+(.*)", err)
        if m:
            raise DBError(m.group(2).strip(), m.group(1))
        raise DBError(err.strip().splitlines()[0] if err.strip() else "psql failed (%d)" % r.returncode)
    return r.stdout


def q(sql, variables=None, timeout=None, dry_run=False):
    """psql that returns one JSON value."""
    out = psql(sql, variables, timeout, dry_run).strip()
    if not out:
        return None
    return json.loads(out)


def explain_db(e):
    if "tickets_jira_key_key" in str(e):
        return ("Relay refused this: another ticket already links that Jira issue, and this database still "
                "allows only one. Apply silver-octo-invention's migration 20261113160000_relay_shared_jira_delete.sql")
    if e.sqlstate == "23514":
        return "Relay refused this (rule): %s" % e
    if e.sqlstate == "23505":
        return "Relay refused this (that ID is taken): %s" % e
    if e.sqlstate == "22021":
        return "Relay refused this (text): %s" % e
    if e.sqlstate == "42883" and "delete_ticket" in str(e):
        return ("this database has no relay.delete_ticket() yet: apply silver-octo-invention's migration "
                "20261113160000_relay_shared_jira_delete.sql")
    if e.sqlstate:
        return "Relay error %s: %s" % (e.sqlstate, e)
    return "can't reach Relay: %s" % e


# ---------------------------------------------------------------------------
# Paths, projects and git (pure parts are unit-tested)
# ---------------------------------------------------------------------------

def norm(p, pm=os.path):
    """Expand ~ and normalise. On Windows this also turns / into \\."""
    return pm.normpath(pm.expanduser(p)) if p else p


def path_under(path, prefix, pm=os.path):
    """Whether path is prefix or inside it, on whole components. Windows paths
    compare case-insensitively. pm is os.path (tests pass ntpath/posixpath)."""
    path, prefix = norm(path, pm), norm(prefix, pm)
    if not path or not prefix:
        return False
    a, b = pm.normcase(path), pm.normcase(prefix)
    sep = pm.sep
    base = b.rstrip(sep)
    if not base or (len(base) == 2 and base[1] == ":"):  # "/" or a drive root such as C:\
        return a.startswith(base)
    return a == base or a.startswith(base + sep)


def match_project(cwd, projects):
    """The non-archived project whose paths hold the longest prefix of cwd,
    matched on whole path components, or None."""
    best, best_len = None, -1
    for p in projects:
        if p.get("archived"):
            continue
        for pre in p.get("paths") or []:
            n = norm(pre)
            if path_under(cwd, n) and len(n) > best_len:
                best, best_len = p, len(n)
    return best


def inbox(projects):
    for p in projects:
        if p.get("key") == "INB":
            return p
    return None


def repo_root(path):
    """The nearest folder at or above path holding .git (a dir or a worktree file)."""
    p = norm(path)
    if p and not os.path.isdir(p):
        p = os.path.dirname(p)
    # Stop at the filesystem root ("/" or a drive root such as C:\), which is never a repo here.
    while p and os.path.dirname(p) != p:
        if os.path.exists(os.path.join(p, ".git")):
            return p
        p = os.path.dirname(p)
    return None


def git(args, cwd, timeout=5.0):
    try:
        r = subprocess.run(["git", "-C", cwd] + args, capture_output=True, text=True, encoding="utf-8",
                           errors="replace", timeout=timeout,
                           env=dict(os.environ, GIT_OPTIONAL_LOCKS="0", LC_ALL="C"), **NO_WINDOW)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def main_worktree(path):
    """For a linked worktree, the main checkout's folder; else None."""
    root = repo_root(path)
    if not root or not os.path.isfile(os.path.join(root, ".git")):
        return None
    out = git(["rev-parse", "--path-format=absolute", "--git-common-dir"], root, 2.0)
    if not out:
        return None
    common = norm(out.strip())  # git prints / even on Windows
    return os.path.dirname(common) if os.path.basename(common) == ".git" else None


def local_paths(path=None):
    """~/.claude/relay/paths.json: {"/folder/prefix": "KEY"}, checked before the
    database's projects.paths (for machines whose folders differ)."""
    try:
        with open(path or os.path.join(home(), "paths.json")) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(d, dict):
        return {}
    return dict((norm(k), v.strip().upper()) for k, v in d.items()
                if isinstance(k, str) and isinstance(v, str) and k.strip())


def match_local(path, projects, overrides):
    best, best_len = None, -1
    for prefix, key in (overrides or {}).items():
        if path_under(path, prefix) and len(prefix) > best_len:
            p = next((x for x in projects if x.get("key") == key and not x.get("archived")), None)
            if p:
                best, best_len = p, len(prefix)
    return best


def project_for(cwd, projects, overrides=None):
    """(project, matched): the local paths.json first, then projects.paths, for the
    folder and then for a linked worktree's main checkout; else Inbox."""
    overrides = local_paths() if overrides is None else overrides
    candidates = [cwd]
    mw = main_worktree(cwd)
    if mw:
        candidates.append(mw)
    for c in candidates:
        p = match_local(c, projects, overrides) or match_project(c, projects)
        if p:
            return p, True
    return inbox(projects), False


def project_paths(project, overrides=None):
    """A project's folders: projects.paths plus this machine's paths.json entries for it."""
    overrides = local_paths() if overrides is None else overrides
    paths = list((project or {}).get("paths") or [])
    key = (project or {}).get("key")
    paths += [f for f, k in sorted(overrides.items()) if key and k == key and f not in paths]
    return paths


def parse_porcelain_z(out):
    """`git status --porcelain=v1 -z` output -> {relative path: XY}."""
    res = {}
    parts = (out or "").split("\0")
    i = 0
    while i < len(parts):
        e = parts[i]
        i += 1
        if len(e) < 4:
            continue
        xy, path = e[:2], e[3:]
        if xy[0] in "RC" or xy[1] in "RC":
            i += 1  # the original path follows a rename/copy
        res[path] = xy
    return res


def repo_state(root):
    """{'head', 'at', 'files': {rel: [XY, mtime_ns|None]}} or None if git fails."""
    st = git(["status", "--porcelain=v1", "-z", "--untracked-files=all"], root, 8.0)
    if st is None:
        return None
    head = (git(["rev-parse", "HEAD"], root, 2.0) or "").strip()
    files = {}
    for rel, xy in parse_porcelain_z(st).items():
        if len(files) >= 5000:
            break
        try:
            mt = os.lstat(os.path.join(root, rel)).st_mtime_ns
        except OSError:
            mt = None
        files[rel] = [xy, mt]
    return {"head": head, "at": time.time(), "files": files}


def changed_since(snap, cur, committed=()):
    """Relative paths changed between two repo_state()s: new or changed dirty
    entries, dirty entries that went clean, and files in commits made since."""
    changed = set()
    sf, cf = snap.get("files") or {}, cur.get("files") or {}
    for p, v in cf.items():
        if list(sf.get(p) or []) != list(v):
            changed.add(p)
    for p in sf:
        if p not in cf:
            changed.add(p)
    changed.update(x for x in committed if x)
    return changed


def committed_since(root, snap, cur):
    if not snap.get("head") or snap.get("head") == cur.get("head"):
        return []
    since = time.strftime("%Y-%m-%d %H:%M:%S %z", time.localtime(snap.get("at") or 0))
    out = git(["log", "--no-merges", "--since=" + since, "--format=", "--name-only",
               snap["head"] + ".." + (cur.get("head") or "HEAD")], root, 5.0)
    return [l for l in (out or "").splitlines() if l.strip()]


def sweep_repo(root, snap, written):
    """[(abs path)] changed in root since snap and not already logged as write/edit,
    plus the new state to re-baseline on."""
    cur = repo_state(root)
    if cur is None:
        return [], None
    rel = changed_since(snap, cur, committed_since(root, snap, cur))
    paths = sorted(norm(os.path.join(root, r)) for r in rel)  # git's / become \ on Windows
    seen = set(os.path.normcase(w) for w in written)
    paths = [p for p in paths if os.path.normcase(p) not in seen]
    if len(paths) > SWEEP_CAP:
        log("sweep: %s has %d changed files; skipped" % (root, len(paths)))
        return [], cur
    return paths, cur


def snapshot_targets(cwd, projects=None, project=None):
    """Git repos to snapshot: cwd's repo and the repos in the project's paths."""
    roots = []
    for p in [cwd] + (project_paths(project) if project else []):
        r = repo_root(p) if p and os.path.exists(p) else None
        if r and r not in roots:
            roots.append(r)
    return roots


def add_snapshots(sid, roots):
    """Snapshot each repo not already in this session's snapshot."""
    st = load_state(sid)
    have = st.get("snapshot") or {}
    new = {}
    for r in roots:
        if r in have or r in new:
            continue
        s = repo_state(r)
        if s is not None:
            new[r] = s
    if new:
        def put(s):
            s.setdefault("snapshot", {})
            for k, v in new.items():
                s["snapshot"].setdefault(k, v)
        update_state(sid, put)
    return list(new)


def do_sweep(sid):
    """Queue every git-changed file since the snapshot as 'shell', then re-baseline."""
    st = load_state(sid)
    snaps = st.get("snapshot") or {}
    written = logged_paths(sid)
    found, rebase = [], {}
    for root, snap in sorted(snaps.items()):
        paths, cur = sweep_repo(root, snap, written)
        if cur is not None:
            rebase[root] = cur
        found.extend(paths)
    cur = current_ticket(st)
    for p in found:
        enqueue({"type": "file", "session": sid, "path": p, "kind": "shell", "at": now_iso(),
                 "ticket_id": (cur or {}).get("id")})
    if rebase:
        def put(s):
            s.setdefault("snapshot", {}).update(rebase)
        update_state(sid, put)
    return found


