    ci = conninfo_fields()
    host, port, db, user = ci.get("host", ""), ci.get("port", "5432"), ci.get("dbname", ""), ci.get("user", "")
    pgpass = os.environ.get("PGPASSFILE") or norm("~/.pgpass")
    ok, detail = pgpass_entry(pgpass, host, port, db, user)
    if not ok and "chmod" not in detail:
        detail += ". Add this line (your password in place of <password>)%s:\n" \
                  "                 %s" % ("" if IS_WIN else ", then chmod 600 " + pgpass, PGPASS_LINE)
    check("pgpass", ok, detail)
    tcp = False
    t0 = time.time()
    try:
        socket.create_connection((host, int(port)), timeout=3).close()
        tcp = True
        check("network", True, "TCP to %s:%s in %.2fs" % (host, port, time.time() - t0))
    except Exception as e:
        check("network", False, "can't open a TCP connection to %s:%s within 3 s (%s). Corporate networks often "
              "block outbound port %s: try another network (a phone hotspot) or ask IT to allow it." % (
                  host, port, e.__class__.__name__, port))
    if tcp:
        try:
            u = q("select json_build_object('u', current_user)", timeout=8)
            check("login", u.get("u") == "claude_relay", "signed in as %s" % u.get("u"))
            try:
                n = q("select json_build_object('n', (select count(*) from relay.projects))", timeout=8)
                check("read", n["n"] > 0, "relay.projects has %d rows" % n["n"])
            except DBError as e:
                check("read", False, explain_db(e))
        except DBError as e:
            check("login", False, explain_db(e))
            check("read", False, "skipped (no login)")
    else:
        check("login", False, "skipped (no network)")
        check("read", False, "skipped (no network)")
    installer = "python cli/install.py" if IS_WIN else "cli/install.sh"
    bins = [bin_path] + ([os.path.join(home(), "bin", n) for n in ("relay", "relay.cmd")] if IS_WIN else [])
    absent = [b for b in bins if not (os.path.isfile(b) if IS_WIN else os.access(b, os.X_OK))]
    check("binary", not absent, ", ".join(bins) if not absent
          else "missing: %s. Run %s" % (", ".join(absent), installer))
    try:
        with open(os.path.join(claude, "settings.json")) as f:
            settings = json.load(f)
    except (OSError, ValueError):
        settings = {}
    missing = []
    for event, matcher, entry, timeout in load_hook_spec():
        found = any(hook_matches(h, bin_path, entry) and (g.get("matcher") or None) == matcher
                    for g in (settings.get("hooks") or {}).get(event) or [] for h in g.get("hooks") or [])
        if not found:
            missing.append("%s%s" % (event, "(%s)" % matcher if matcher else ""))
    check("hooks", not missing, "all %d in %s" % (len(load_hook_spec()), os.path.join(claude, "settings.json")) if not missing
          else "missing: %s. Run %s" % (", ".join(missing), installer))
    user_problems = policy_problems(settings, managed=False)
    if user_problems:
        check("hooks-on", False, "your %s: %s" % (os.path.join(claude, "settings.json"), "; ".join(user_problems)))
    sources = managed_sources()
    problems = []
    for label, data, err in sources:
        if err:
            problems.append("%s %s" % (label, err))
        for msg in policy_problems(data):
            problems.append("%s: %s" % (label, msg))
    if problems:
        check("managed", False, "organisation settings stop Relay: " + " | ".join(problems) +
              ". The CLI still works by hand (relay attach, notes, close), but nothing runs automatically.")
    else:
        check("managed", True, ("%d local managed source(s), none blocks user hooks or skills" % len(sources))
              if sources else "no local managed settings (file, managed-settings.d or %s)" % (
                  "registry policy" if IS_WIN else "MDM"))
    skills = [n for n in SKILLS if not os.path.exists(os.path.join(claude, "skills", n, "SKILL.md"))]
    check("skills", not skills, "%s in %s" % (", ".join(SKILLS), os.path.join(claude, "skills")) if not skills
          else "missing: %s. Run %s" % (", ".join(skills), installer))
    md = os.environ.get("RELAY_MANAGED_DIR") or MANAGED_DIR
    for name, alias in (("close", "/relay-close"), ("relay", "/relay-tickets")):
        if os.path.exists(os.path.join(md, ".claude", "skills", name, "SKILL.md")):
            print("warn  an organisation skill named %s takes /%s (managed skills win over personal ones): "
                  "type %s instead" % (name, name, alias))
    try:
        with open(os.path.join(claude, "CLAUDE.md")) as f:
            has_block = BLOCK_BEGIN in f.read()
    except OSError:
        has_block = False
    check("rule", has_block, "ticket rule block in %s" % os.path.join(claude, "CLAUDE.md") if has_block
          else "no Relay block in %s. Run %s" % (os.path.join(claude, "CLAUDE.md"), installer))
    overrides = local_paths()
    print("info  paths.json: %s" % ("%d folder override(s)" % len(overrides) if overrides else "none"))
    print("info  session: %s" % (sid or "(none: outside Claude Code)"))
    st = load_state(sid)
    if st:
        print("info  attached: %s" % (", ".join(x["key"] for x in st.get("tickets") or []) or "nothing"))
    print("info  queued jobs: %d" % len(queue_jobs()))
    print("info  server-managed settings (claude.ai admin console) can't be read from here: inside Claude Code, "
          "check /status (Setting sources) and `claude doctor` (Managed settings (remote))")
    if fails:
        print("%d check(s) failed: %s" % (len(fails), ", ".join(fails)))
        return 1
    print("All checks passed.")
    return 0


# ---------------------------------------------------------------------------
# Hooks. Each one: read stdin JSON, stay inside its time box, print only
# context on success, print nothing on failure, always exit 0.
# ---------------------------------------------------------------------------

def read_hook_input():
    try:
        data = sys.stdin.read()
        return json.loads(data) if data.strip() else {}
    except Exception:
        return {}


def hook_session_start(inp):
    sid = inp.get("session_id") or ""
    cwd = norm(inp.get("cwd") or os.getcwd())
    env_file = os.environ.get("CLAUDE_ENV_FILE")
    if env_file and sid:
        try:
            with open(env_file, "a") as f:
                f.write("export RELAY_SESSION_ID=%s\n" % shlex.quote(sid))
        except OSError:
            pass
    if sid:
        def put(s):
            s.setdefault("cwd", cwd)
            s.setdefault("started_at", time.time())
            s["source"] = inp.get("source")
            s.pop("ended", None)  # a resumed session is live again
        update_state(sid, put)
        spawn_bg(["--session", sid, "--cwd", cwd, "--snapshot", "--flush"])
    data = q(SQL_CONTEXT, {"tz": TZ}, timeout=remaining())
    text = format_context(data or {}, cwd, sid, load_state(sid))
    sys.stdout.write(hook_json("SessionStart", text))


def hook_file(inp):
    sid = inp.get("session_id") or ""
    tool = inp.get("tool_name") or ""
    ti = inp.get("tool_input") or {}
    path = ti.get("file_path") or ti.get("notebook_path") or ""
    if not sid or not path:
        return
    path = norm(path if os.path.isabs(path) else os.path.join(inp.get("cwd") or os.getcwd(), path))
    scratch = inp.get("scratchpad_dir")
    if scratch and path_under(path, scratch):
        return
    kind = "write" if tool == "Write" else "edit"
    enqueue({"type": "file", "session": sid, "path": path, "kind": kind, "at": now_iso()})
    with open(paths_file(sid), "a") as f:
        f.write(path + "\n")


def _check_file(sid):
    return os.path.join(sdir("sessions"), safe_sid(sid) + ".check")


def throttled(sid, every=NOTES_EVERY):
    """True when the last check was less than `every` seconds ago (or we're backing off)."""
    try:
        return time.time() < os.stat(_check_file(sid)).st_mtime + every
    except OSError:
        return False


def mark_checked(sid, backoff=0):
    p = _check_file(sid)
    with open(p, "a"):
        pass
    t = time.time() + backoff
    os.utime(p, (t, t))


def notes_for(st, timeout=None):
    ids = [x["id"] for x in st.get("tickets") or []]
    if not ids:
        return []
    return q(SQL_NOTES, {"ids": "{%s}" % ",".join(ids), "tz": TZ}, timeout=timeout) or []


def hook_post_tool(inp):
    sid = inp.get("session_id") or ""
    if not sid or throttled(sid):
        return
    st = load_state(sid)
    mark_checked(sid)
    if not st.get("tickets"):
        return
    try:
        notes = notes_for(st, timeout=remaining())
    except DBError as e:
        if not e.sqlstate:
            mark_checked(sid, BACKOFF - NOTES_EVERY)
        raise
    if remaining() > 1.5:
        # lazy snapshots for repos this session has started editing, then flush
        roots = [r for r in set(repo_root(p) for p in logged_paths(sid)) if r]
        add_snapshots(sid, roots)
        try:
            flush()
        except Exception as e:
            log("post-tool flush: %s" % e)
    if notes:
        sys.stdout.write(hook_json("PostToolUse", format_notes(notes)))


def hook_prompt(inp):
    sid = inp.get("session_id") or ""
    if not sid:
        return
    cwd = norm(inp.get("cwd") or os.getcwd())
    m = KICKOFF_RE.match(inp.get("prompt") or "")
    st = load_state(sid)
    parts = []
    if m:
        key = norm_key(m.group(1))
        do_attach(key, sid, cwd)
        st = load_state(sid)
        d = q(SQL_GET, {"key": key, "tz": TZ, "mark": "1"}, timeout=remaining())
        if d and d.get("ticket"):
            parts.append("# Relay: this session is now attached to %s. Its handoff (relay get %s):\n\n%s"
                         % (key, key, format_get(d)))
    if st.get("tickets"):
        notes = notes_for(st, timeout=remaining())
        if notes:
            parts.insert(0, format_notes(notes))
        mark_checked(sid)
    if parts:
        text = "\n\n".join(parts)
        if len(text) > CONTEXT_CAP:
            text = text[:CONTEXT_CAP - 80] + "\n… (truncated; run `relay get %s`)" % (m.group(1).upper() if m else "KEY")
        sys.stdout.write(hook_json("UserPromptSubmit", text))


def hook_session_end(inp):
    sid = inp.get("session_id") or ""
    if not sid:
        return
    st = load_state(sid)
    if st.get("tickets") and not st.get("closed"):
        enqueue({"type": "session_end", "session": sid, "cwd": inp.get("cwd") or st.get("cwd"),
                 "reason": inp.get("reason"), "at": now_iso(),
                 "last_message": last_assistant_text(inp.get("transcript_path"))})
    spawn_bg(["--session", sid, "--sweep", "--flush", "--ended"])


def hook_bg(argv):
    """The detached worker: snapshot, sweep and flush with a generous time box."""
    p = argparse.ArgumentParser(prog="relay hook bg")
    p.add_argument("--session", default="")
    p.add_argument("--cwd", default="")
    p.add_argument("--snapshot", action="store_true")
    p.add_argument("--sweep", action="store_true")
    p.add_argument("--flush", action="store_true")
    p.add_argument("--ended", action="store_true")
    a = p.parse_args(argv)
    if a.snapshot and a.session:
        projects = []
        try:
            projects = q(SQL_PROJECTS, timeout=10) or []
        except DBError:
            pass
        proj, matched = project_for(a.cwd, projects) if projects else (None, False)
        add_snapshots(a.session, snapshot_targets(a.cwd, project=proj if matched else None))
    if a.sweep and a.session and current_ticket(load_state(a.session)):
        do_sweep(a.session)
    if a.ended and a.session and not current_ticket(load_state(a.session)):
        update_state(a.session, lambda s: s.update({"ended": True}))
    if a.flush:
        flush()
    prune_sessions()


HOOKS = {
    "session-start": (hook_session_start, 4.5),
    "file": (hook_file, 1.5),
    "post-tool": (hook_post_tool, 4.0),
    "prompt": (hook_prompt, 6.0),
    "session-end": (hook_session_end, 1.0),
}


def run_hook(argv):
    event = argv[0] if argv else ""
    if event == "bg":
        start_timebox(60)
        try:
            hook_bg(argv[1:])
        except BaseException as e:
            log("hook bg: %r" % e)
        return 0
    fn, budget = HOOKS.get(event, (None, 0))
    if not fn:
        return 0
    real_stdout = sys.stdout
    try:
        start_timebox(budget)
        inp = read_hook_input()
        buf = _Buffer()
        sys.stdout = buf
        fn(inp)
        stop_timebox()
        sys.stdout = real_stdout
        if buf.text:
            real_stdout.write(buf.text)
            real_stdout.flush()
    except BaseException as e:
        try:
            stop_timebox()
        except Exception:
            pass
        sys.stdout = real_stdout
        # Windows' time box arrives as KeyboardInterrupt (see start_timebox).
        boxed = isinstance(e, TimeBox) or (IS_WIN and isinstance(e, KeyboardInterrupt))
        log("hook %s: %s" % (event, "time box reached" if boxed else repr(e)))
    return 0


class _Buffer(object):
    """Hook output is held back until the hook has finished, so a hook that
    fails half-way prints nothing."""

    def __init__(self):
        self.text = ""

    def write(self, s):
        self.text += s

    def flush(self):
        pass


# ---------------------------------------------------------------------------
# Setup: merge hooks into settings.json, install skills and the CLAUDE.md rule
# ---------------------------------------------------------------------------

HOOK_SPEC = [
    ("SessionStart", None, "session-start", 10),
    ("UserPromptSubmit", None, "prompt", 10),
    ("PostToolUse", "Write|Edit|NotebookEdit", "file", 5),
    ("PostToolUse", "*", "post-tool", 10),
    ("SessionEnd", None, "session-end", 10),
]


def load_hook_spec(src=None):
    """The hooks Relay installs: cli/hooks.json next to the source (or the installed
    copy next to the binary), else the built-in HOOK_SPEC."""
    for d in [src, os.path.dirname(os.path.abspath(__file__))]:
        if not d:
            continue
        try:
            with open(os.path.join(d, "hooks.json")) as f:
                rows = json.load(f)["hooks"]
            return [(r["event"], r.get("matcher"), r["entry"], int(r["timeout"])) for r in rows]
        except (OSError, ValueError, KeyError, TypeError):
            continue
    return list(HOOK_SPEC)


def fwd(p):
    """A path with / separators: what Windows settings.json entries use."""
    return p.replace("\\", "/") if p else p


def hook_entry(bin_path, name, timeout, win=IS_WIN, python=None):
    """One settings.json hook. POSIX: a shell command that runs the script by its
    shebang. Windows: the exec form (command = python.exe, args = the rest), so no
    shell is involved and Git Bash vs PowerShell doesn't matter; -X utf8 makes
    every file, pipe and stdio UTF-8 instead of the ANSI code page."""
    if not win:
        return {"type": "command", "command": "%s hook %s" % (shlex.quote(bin_path), name), "timeout": timeout}
    return {"type": "command", "command": fwd(python or sys.executable),
            "args": ["-X", "utf8", fwd(bin_path), "hook", name], "timeout": timeout}


def hook_matches(h, bin_path, name, win=IS_WIN):
    """Whether settings.json hook h is Relay's hook `name` for this install."""
    h = h or {}
    if not win:
        return h.get("command") == "%s hook %s" % (shlex.quote(bin_path), name)
    return (h.get("args") == ["-X", "utf8", fwd(bin_path), "hook", name]
            and bool(h.get("command")) and os.path.isfile(h["command"]))


def is_relay_hook(h, bin_path):
    h = h or {}
    text = " ".join([h.get("command") or ""] + [a for a in h.get("args") or [] if isinstance(a, str)])
    text = fwd(text) if IS_WIN else text
    return RELAY_MARK in text or bool(bin_path and fwd(bin_path) in text) or bool(bin_path and bin_path in text)


def merge_hooks(settings, bin_path, spec=None):
    """Return a copy of settings with Relay's hooks in place. Other hooks and
    keys are kept; earlier Relay hooks are replaced, so it is idempotent."""
    s = json.loads(json.dumps(settings or {}))
    hooks = s.get("hooks") or {}
    for event in list(hooks):
        groups = []
        for g in hooks[event] or []:
            kept = [h for h in g.get("hooks") or [] if not is_relay_hook(h, bin_path)]
            if kept:
                g = dict(g, hooks=kept)
                groups.append(g)
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]
    for event, matcher, name, timeout in (spec or HOOK_SPEC):
        g = {"hooks": [hook_entry(bin_path, name, timeout)]}
        if matcher:
            g = dict([("matcher", matcher)] + list(g.items()))
        hooks.setdefault(event, []).append(g)
    s["hooks"] = hooks
    return s


BLOCK_BEGIN = "<!-- relay:begin (managed by relay setup) -->"
BLOCK_END = "<!-- relay:end -->"


def merge_block(existing, block):
    """Put block between the relay markers, replacing an earlier one."""
    body = "%s\n%s\n%s\n" % (BLOCK_BEGIN, block.strip(), BLOCK_END)
    existing = existing or ""
    i, j = existing.find(BLOCK_BEGIN), existing.find(BLOCK_END)
    if i >= 0 and j > i:
        return existing[:i] + body + existing[j + len(BLOCK_END):].lstrip("\n")
    if existing.strip():
        return existing.rstrip("\n") + "\n\n" + body
    return body


def cmd_setup(args):
    claude = norm(args.claude_dir)
    src = norm(args.src)
    bin_path = norm(args.bin)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    settings_path = os.path.join(claude, "settings.json")
    real = os.path.realpath(settings_path)
    try:
        with open(real) as f:
            raw = f.read()
        settings = json.loads(raw) if raw.strip() else {}
    except FileNotFoundError:
        raw, settings = None, {}
    merged = merge_hooks(settings, bin_path, load_hook_spec(src))
    text = json.dumps(merged, indent=2) + "\n"
    claude_md = os.path.join(claude, "CLAUDE.md")
    try:
        with open(claude_md) as f:
            md_old = f.read()
    except FileNotFoundError:
        md_old = ""
    with open(os.path.join(src, "claude-md-rule.md")) as f:
        md_new = merge_block(md_old, f.read())
    if args.dry_run:
        print(text)
        print(md_new)
        return
    for name in sorted(os.listdir(os.path.join(src, "skills"))):
        if not os.path.isfile(os.path.join(src, "skills", name, "SKILL.md")):
            continue
        with open(os.path.join(src, "skills", name, "SKILL.md")) as f:
            atomic_write(os.path.join(claude, "skills", name, "SKILL.md"), f.read())
    with open(os.path.join(src, "hooks.json")) as f:  # beside the binary, for `relay doctor`
        atomic_write(os.path.join(os.path.dirname(bin_path), "hooks.json"), f.read())
    if md_new != md_old:
        atomic_write(claude_md, md_new)
    if raw is not None:
        had = any(is_relay_hook(h, bin_path) for gs in (settings.get("hooks") or {}).values()
                  for g in gs or [] for h in g.get("hooks") or [])
        backup = os.path.join(claude, "backups", "settings.json.%s-%s" % (
            "relay-reinstall" if had else "pre-relay", stamp))
        os.makedirs(os.path.dirname(backup), exist_ok=True)
        shutil.copy2(real, backup)
        print("Backed up settings.json to %s" % backup)
    mode = os.stat(real).st_mode & 0o777 if raw is not None else 0o644
    atomic_write(real, text, mode)
    print("Hooks merged into %s; skills %s and the CLAUDE.md rule installed." % (settings_path, ", ".join(SKILLS)))


