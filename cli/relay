# ---------------------------------------------------------------------------
# Errors and the time box
# ---------------------------------------------------------------------------

class RelayError(Exception):
    """A user-facing error: printed as `relay: <message>`, exit 1."""


class DBError(RelayError):
    """psql failed. sqlstate is set when the server rejected the statement."""

    def __init__(self, message, sqlstate=None):
        RelayError.__init__(self, message)
        self.sqlstate = sqlstate


class TimeBox(Exception):
    pass


_deadline = [None]
_timers = []


def start_timebox(seconds):
    """Hooks run under a hard wall-clock limit. POSIX: SIGALRM raises TimeBox.
    Windows has no SIGALRM: a timer thread interrupts the main thread
    (KeyboardInterrupt, caught like TimeBox), and a second one ends the process
    a moment later in case the main thread is stuck in a blocking call."""
    _deadline[0] = time.time() + seconds
    if not IS_WIN:
        def _fire(signum, frame):
            raise TimeBox()
        signal.signal(signal.SIGALRM, _fire)
        signal.setitimer(signal.ITIMER_REAL, seconds)
        return

    def _hard():
        log("time box reached; exiting")
        os._exit(0)
    for delay, fn in ((seconds, _thread.interrupt_main), (seconds + 1.0, _hard)):
        t = threading.Timer(delay, fn)
        t.daemon = True
        t.start()
        _timers.append(t)


def stop_timebox():
    if not IS_WIN:
        signal.setitimer(signal.ITIMER_REAL, 0)
        return
    while _timers:
        _timers.pop().cancel()


def remaining(default=8.0):
    if _deadline[0] is None:
        return default
    return max(0.2, _deadline[0] - time.time() - 0.15)


# ---------------------------------------------------------------------------
# Local state: ~/.claude/relay/
# ---------------------------------------------------------------------------

def home():
    return os.environ.get("RELAY_HOME") or os.path.expanduser("~/.claude/relay")


def sdir(*parts):
    d = os.path.join(home(), *parts)
    os.makedirs(d, exist_ok=True)
    return d


def log(msg):
    """Hook failures go to a small log file, never to stdout or stderr."""
    try:
        path = os.path.join(sdir("log"), "relay.log")
        if os.path.exists(path) and os.path.getsize(path) > 1000000:
            os.replace(path, path + ".1")
        with open(path, "a") as f:
            f.write("%s [%d] %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), os.getpid(), msg))
    except Exception:
        pass


def atomic_write(path, text, mode=0o644):
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=d)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        _replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _replace(src, dst):
    """os.replace. On Windows it fails while another process has dst open (a
    reader mid-read), so it retries briefly."""
    for i in range(20 if IS_WIN else 1):
        try:
            os.replace(src, dst)
            return
        except PermissionError:
            if not IS_WIN or i == 19:
                raise
            time.sleep(0.025)


def lock_fd(fd, blocking=True):
    """Exclusive lock on an open file. Returns False if non-blocking and taken."""
    if not IS_WIN:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
            return True
        except OSError:
            if blocking:
                raise
            return False
    os.lseek(fd, 0, 0)
    while True:
        try:
            msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
            return True
        except OSError:
            if not blocking:
                return False
            time.sleep(0.02)


def unlock_fd(fd):
    if not IS_WIN:
        fcntl.flock(fd, fcntl.LOCK_UN)
        return
    os.lseek(fd, 0, 0)
    msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)


def safe_sid(sid):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", sid or "")[:120]


def state_path(sid):
    return os.path.join(sdir("sessions"), safe_sid(sid) + ".json")


def load_state(sid):
    if not sid:
        return {}
    try:
        with open(state_path(sid)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


class StateLock(object):
    """A file lock around a read-modify-write of one session's state file."""

    def __init__(self, sid):
        self.path = os.path.join(sdir("sessions"), safe_sid(sid) + ".lock")
        self.fd = None

    def __enter__(self):
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o644)
        lock_fd(self.fd)
        return self

    def __exit__(self, *a):
        try:
            unlock_fd(self.fd)
        finally:
            os.close(self.fd)


def update_state(sid, fn):
    with StateLock(sid):
        st = load_state(sid)
        st.setdefault("session_id", sid)
        fn(st)
        atomic_write(state_path(sid), json.dumps(st, indent=1, sort_keys=True))
        return st


def current_ticket(st):
    """The ticket this session works on: the last one it attached."""
    tickets = st.get("tickets") or []
    return tickets[-1] if tickets else None


def paths_file(sid):
    return os.path.join(sdir("sessions"), safe_sid(sid) + ".paths")


def logged_paths(sid):
    """Paths this session changed with Write/Edit/NotebookEdit (from the file hook)."""
    try:
        with open(paths_file(sid)) as f:
            return set(line.rstrip("\n") for line in f if line.strip())
    except OSError:
        return set()


def session_id(args=None):
    sid = getattr(args, "session", None) if args is not None else None
    return sid or os.environ.get("RELAY_SESSION_ID") or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""


def actor(sid):
    return "claude:" + (sid or "cli")


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


# ---------------------------------------------------------------------------
# The offline queue: one JSON file per job in queue/, written atomically
# ---------------------------------------------------------------------------

def enqueue(job, qdir=None):
    qdir = qdir or sdir("queue")
    job = dict(job)
    job.setdefault("queued_at", time.time())
    name = "%020d-%d-%s.json" % (time.time_ns(), os.getpid(), uuid.uuid4().hex[:8])
    atomic_write(os.path.join(qdir, name), json.dumps(job))
    return name


def queue_jobs(qdir=None):
    """[(name, job)] oldest first. Unreadable files are removed."""
    qdir = qdir or sdir("queue")
    out = []
    try:
        names = sorted(n for n in os.listdir(qdir) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return out
    for n in names:
        p = os.path.join(qdir, n)
        try:
            with open(p) as f:
                out.append((n, json.load(f)))
        except ValueError:
            ack([n], qdir)
        except OSError:
            pass
    return out


def ack(names, qdir=None):
    qdir = qdir or sdir("queue")
    for n in names:
        try:
            os.unlink(os.path.join(qdir, n))
        except OSError:
            pass


class QueueLock(object):
    """Only one flusher at a time. acquired is False when another holds it."""

    def __init__(self, qdir=None):
        self.path = os.path.join(qdir or sdir("queue"), ".lock")
        self.fd = None
        self.acquired = False

    def __enter__(self):
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o644)
        self.acquired = lock_fd(self.fd, blocking=False)
        return self

    def __exit__(self, *a):
        if self.acquired:
            unlock_fd(self.fd)
        os.close(self.fd)


def plan_flush(jobs, states, now=None):
    """Split queued jobs into what can be sent now.

    jobs: [(name, job)]; states: {session_id: state}.
    Returns (files, ends, drop): files is [(name, ticket_id, job)], ends is
    [(name, state, job)], drop is [name]. Jobs neither sent nor dropped stay
    queued (a session that hasn't attached a ticket yet).
    """
    now = now or time.time()
    files, ends, drop = [], [], []
    for name, job in jobs:
        st = states.get(job.get("session")) or {}
        cur = current_ticket(st)
        if job.get("type") == "file":
            tid = job.get("ticket_id") or (cur or {}).get("id")
            if tid:
                files.append((name, tid, job))
            elif st.get("ended") or now - job.get("queued_at", now) > UNATTACHED_TTL:
                drop.append(name)
        elif job.get("type") == "session_end":
            if cur and not st.get("closed"):
                ends.append((name, st, job))
            else:
                drop.append(name)
        else:
            drop.append(name)
    return files, ends, drop


