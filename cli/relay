         'at', to_char(n.at at time zone :'tz', 'DD Mon HH24:MI')) order by n.at), '[]')
  from n join relay.tickets t on t.id = n.ticket_id
"""

SQL_SESSION_END = """
with u as (
  update relay.tickets set needs_wrapup = true, updated_by = 'hook:session-end'
   where id = :'tid'::uuid
  returning id
),
e as (
  insert into relay.events (ticket_id, actor, kind, body)
  select id, 'hook:session-end', 'note', :'body' from u
  returning 1
),
s as (
  insert into relay.sessions as ss (ticket_id, session_id, machine, cwd, ended_at, closed_by)
  select id, :'sid', :'machine', :'cwd', :'at'::timestamptz, 'session-end' from u
  on conflict (ticket_id, session_id) do update
     set ended_at = excluded.ended_at, closed_by = coalesce(ss.closed_by, 'session-end')
  returning 1
)
select json_build_object('ticket', (select count(*) from u), 'event', (select count(*) from e),
                         'session', (select count(*) from s))
"""


def common_vars(sid=None, cwd=None):
    return {"tz": TZ, "sid": sid or "", "by": actor(sid), "machine": socket.gethostname(),
            "cwd": cwd or os.getcwd()}


# ---------------------------------------------------------------------------
# Flushing the queue
# ---------------------------------------------------------------------------

def _log_files_sql(n):
    rows = ", ".join("(:'t%d', :'p%d', :'k%d', :'s%d', :'a%d')" % (i, i, i, i, i) for i in range(n))
    return ("select json_build_object('n', count(*)) from (values %s) v(t, p, k, s, a), "
            "lateral relay.log_file(v.t::uuid, v.p, v.k, nullif(v.s, ''), v.a::timestamptz) f" % rows)


def _send_files(batch):
    variables = {}
    for i, (name, tid, job) in enumerate(batch):
        variables.update({"t%d" % i: tid, "p%d" % i: job.get("path"), "k%d" % i: job.get("kind") or "shell",
                          "s%d" % i: job.get("session") or "", "a%d" % i: job.get("at") or now_iso()})
    q(_log_files_sql(len(batch)), variables)


def flush(raise_errors=False):
    """Send queued jobs to Relay. Returns (sent, kept). Keeps everything on a
    network failure; drops a job the database rejects (it would never succeed)."""
    sent = kept = 0
    with QueueLock() as lock:
        if not lock.acquired:
            return 0, -1
        jobs = queue_jobs()
        if not jobs:
            return 0, 0
        sids = set(j.get("session") for _, j in jobs)
        states = dict((s, load_state(s)) for s in sids if s)
        files, ends, drop = plan_flush(jobs, states)
        ack(drop)
        kept = len(jobs) - len(files) - len(ends) - len(drop)
        try:
            for i in range(0, len(files), 100):
                batch = files[i:i + 100]
                try:
                    _send_files(batch)
                    ack([b[0] for b in batch])
                    sent += len(batch)
                except DBError as e:
                    if not e.sqlstate:
                        raise
                    for one in batch:  # find and drop the job the database rejects
                        try:
                            _send_files([one])
                            sent += 1
                        except DBError as e2:
                            if not e2.sqlstate:
                                raise
                            log("flush: dropped %s (%s %s)" % (one[2].get("path"), e2.sqlstate, e2))
                        ack([one[0]])
            for name, st, job in ends:
                cur = current_ticket(st)
                v = common_vars(job.get("session"), job.get("cwd"))
                v.update({"tid": cur["id"], "body": session_end_note(job), "at": job.get("at") or now_iso()})
                try:
                    q(SQL_SESSION_END, v)
                    sent += 1
                except DBError as e:
                    if not e.sqlstate:
                        raise
                    log("flush: session_end for %s dropped (%s %s)" % (job.get("session"), e.sqlstate, e))
                ack([name])
                update_state(job.get("session"), lambda s: s.update({"ended": True}))
        except DBError as e:
            log("flush: kept queue (%s)" % e)
            if raise_errors:
                raise
            kept += len(queue_jobs())
    return sent, kept


def session_end_note(job):
    msg = (job.get("last_message") or "").strip()
    if len(msg) > 4000:
        msg = msg[:4000] + "\n[…]"
    head = "Session %s ended without /close (%s)." % (job.get("session"), job.get("reason") or "exit")
    return head + ("\n\nLast message:\n\n" + msg if msg else "\n\nNo last message was found in the transcript.")


def prune_sessions():
    cutoff = time.time() - SESSION_TTL
    d = sdir("sessions")
    for n in os.listdir(d):
        p = os.path.join(d, n)
        try:
            if os.path.getmtime(p) < cutoff:
                os.unlink(p)
        except OSError:
            pass


def spawn_bg(args):
    """Start `relay hook bg ...` fully detached, so it outlives the hook and the session."""
    cmd = [sys.executable] + (["-X", "utf8"] if IS_WIN else []) + [os.path.abspath(__file__), "hook", "bg"] + args
    io = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True)
    if not IS_WIN:
        try:
            subprocess.Popen(cmd, start_new_session=True, **io)
        except Exception as e:
            log("spawn_bg: %s" % e)
        return
    # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP, plus CREATE_BREAKAWAY_FROM_JOB so the worker
    # survives Claude Code ending the hook's job; some jobs forbid breakaway, so retry without it.
    for flags in (0x00000008 | 0x00000200 | 0x01000000, 0x00000008 | 0x00000200):
        try:
            subprocess.Popen(cmd, creationflags=flags, **io)
            return
        except OSError as e:
            err = e
    log("spawn_bg: %s" % err)


