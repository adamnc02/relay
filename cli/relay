def policy_problems(settings, managed=True):
    """Plain-English reasons a settings object stops Relay's user-level hooks or skills."""
    out = []
    if not isinstance(settings, dict):
        return out
    if settings.get("disableAllHooks") is True:
        out.append("disableAllHooks: true turns every hook off, Relay's included" +
                   (" (only an admin can change managed settings)" if managed else
                    ": remove it from your settings.json"))
    if managed and settings.get("allowManagedHooksOnly") is True:
        out.append("allowManagedHooksOnly: true runs only the organisation's hooks, so Relay's hooks in "
                   "~/.claude/settings.json are skipped")
    spo = settings.get("strictPluginOnlyCustomization") if managed else None
    if spo is True or (isinstance(spo, list) and ({"hooks", "skills"} & set(spo))):
        what = "hooks and skills" if spo is True or {"hooks", "skills"} <= set(spo) else \
            ("hooks" if "hooks" in spo else "skills")
        out.append("strictPluginOnlyCustomization (%s) allows %s only from plugins, so Relay's user-level %s "
                   "are skipped" % (json.dumps(spo), what, what))
    return out


def managed_sources(managed_dir=None):
    """[(label, settings dict or None, error)] for the local managed-settings sources:
    managed-settings.json, managed-settings.d/*.json and the MDM domain."""
    d = managed_dir or os.environ.get("RELAY_MANAGED_DIR") or MANAGED_DIR
    files = [os.path.join(d, "managed-settings.json")]
    try:
        files += sorted(os.path.join(d, "managed-settings.d", n) for n in os.listdir(os.path.join(d, "managed-settings.d"))
                        if n.endswith(".json"))
    except OSError:
        pass
    out = []
    for f in files:
        if not os.path.exists(f):
            continue
        try:
            with open(f) as fh:
                out.append((f, json.load(fh), None))
        except (OSError, ValueError) as e:
            out.append((f, None, "can't be read or parsed (%s)" % e.__class__.__name__))
    if managed_dir is None and not os.environ.get("RELAY_MANAGED_DIR") and IS_WIN:
        out += registry_sources()
    elif managed_dir is None and not os.environ.get("RELAY_MANAGED_DIR"):
        import plistlib
        for plist in ("/Library/Managed Preferences/%s.plist" % MDM_DOMAIN,
                      os.path.expanduser("~/Library/Managed Preferences/%s.plist" % MDM_DOMAIN)):
            if os.path.exists(plist):
                try:
                    with open(plist, "rb") as fh:
                        out.append(("MDM " + plist, plistlib.load(fh), None))
                except Exception as e:
                    out.append(("MDM " + plist, None, "can't be read (%s)" % e.__class__.__name__))
        try:
            r = subprocess.run(["defaults", "export", MDM_DOMAIN, "-"], capture_output=True, timeout=5)
            if r.returncode == 0 and r.stdout.strip():
                data = plistlib.loads(r.stdout)
                if data:
                    out.append(("defaults domain " + MDM_DOMAIN, data, None))
        except Exception:
            pass
    return out


def registry_sources():
    """Windows policy settings: HKLM, then HKCU, SOFTWARE\\Policies\\ClaudeCode, value Settings."""
    import winreg
    out = []
    for hive, name in ((winreg.HKEY_LOCAL_MACHINE, "HKLM"), (winreg.HKEY_CURRENT_USER, "HKCU")):
        label = "registry %s\\%s" % (name, WIN_POLICY_KEY)
        try:
            with winreg.OpenKey(hive, WIN_POLICY_KEY) as k:
                raw, _ = winreg.QueryValueEx(k, "Settings")
        except OSError:
            continue
        try:
            data = json.loads(raw)
            out.append((label, data if isinstance(data, dict) else None,
                        None if isinstance(data, dict) else "isn't a JSON object"))
        except (TypeError, ValueError):
            out.append((label, None, "can't be parsed as JSON"))
    return out


