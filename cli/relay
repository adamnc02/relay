def pgpass_entry(path, host, port, db, user):
    """(found, detail) for a ~/.pgpass line psql would use for this connection."""
    try:
        st = os.stat(path)
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return False, "%s doesn't exist" % path
    want = [host, port, db, user]
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = re.split(r"(?<!\\):", line, 4)
        if len(parts) == 5 and all(a == "*" or a == b for a, b in zip(parts[:4], want)) and parts[4]:
            if st.st_mode & 0o077:
                return False, "%s has the entry but psql ignores it: run chmod 600 %s" % (path, path)
            return True, "%s has an entry for %s (mode 600)" % (path, user)
    return False, "no line for %s in %s" % (user, path)


