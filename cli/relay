def label(status):
    return LABELS.get(status, status or "?")


def ticket_line(t):
    s = "%s [%s] %s" % (t["key"], label(t["status"]), t["title"])
    if t.get("children"):
        s += " (parent: %d/%d phases done)" % (t.get("children_done") or 0, t["children"])
    if t.get("status") == "waiting" and t.get("need"):
        s += " · need: " + t["need"]
    if t.get("needs_wrapup"):
        s += " · CLOSED WITHOUT WRAP-UP"
    return s


def order_tree(tickets):
    """Parents followed by their own children, children indented."""
    by_parent = {}
    for t in tickets:
        if t.get("parent_id"):
            by_parent.setdefault(t["parent_id"], []).append(t)
    ids = set(t["id"] for t in tickets)
    out = []
    for t in tickets:
        if t.get("parent_id") and t["parent_id"] in ids:
            continue
        out.append(("", t))
        for c in by_parent.get(t["id"], []):
            out.append(("  ", c))
    return out


def format_context(data, cwd, sid=None, st=None, cap=CONTEXT_CAP):
    projects = data.get("projects") or []
    tickets = data.get("tickets") or []
    proj, matched = project_for(cwd, projects)
    pkey = (proj or {}).get("key")
    lines = ["# Relay (Adam's projects board)"]
    if matched:
        lines.append("This folder belongs to project %s (%s): a new ticket goes there unless the work "
                     "is for another project (`relay create --project KEY`)." % (pkey, proj.get("name")))
    else:
        lines.append("This folder matches no Relay project. When the project is known (the app chosen "
                     "in app-session, or one named or clear from the chat), pass `relay create --project "
                     "KEY`; only when none fits does the ticket go to the Inbox (INB), for Adam to file.")
    cur = current_ticket(st or {})
    if cur:
        lines.append("This session is attached to %s." % cur.get("key"))
    wrap = [t for t in tickets if t.get("needs_wrapup") and
            (t.get("project") == pkey and matched or (t.get("last_cwd") and path_under(t["last_cwd"], cwd)))]
    if wrap:
        lines.append("")
        lines.append("## Closed without wrap-up — raise these with Adam first")
        for t in wrap:
            lines.append("- %s \"%s\" (%s), last session ended %s. Ask: \"%s was closed without wrap-up. "
                         "Mark it done, or carry on?\"" % (t["key"], t["title"], label(t["status"]),
                                                           t.get("ended") or "?", t["key"]))
    open_here = [t for t in tickets if t.get("project") == pkey and t.get("status") != "done"]
    lines.append("")
    if open_here:
        lines.append("## Open tickets in %s" % pkey)
        shown = order_tree(open_here)
        for ind, t in shown[:30]:
            lines.append("%s- %s" % (ind, ticket_line(t)))
        if len(shown) > 30:
            lines.append("- … and %d more (`relay find --project %s ''`)" % (len(shown) - 30, pkey))
    else:
        lines.append("## No open tickets in %s" % pkey)
    waiting = [t for t in tickets if t.get("status") == "waiting" and t.get("project") != pkey]
    if waiting:
        lines.append("")
        lines.append("## Waiting for Adam (other projects)")
        for t in waiting[:20]:
            lines.append("- %s %s · need: %s" % (t["key"], t["title"], t.get("need") or "?"))
    lines.append("")
    lines.append("## The ticket rule")
    lines.append("Real work (changing files, publishing, a build or a phase) gets a Relay ticket as soon as "
                 "it's clear, before planning or code: `relay find TEXT`, else `relay create \"title\"` "
                 "(add `--parent KEY` for a phase); then `relay attach KEY`. Quick questions answered in the "
                 "same session don't, unless they grow. \"Continue KEY.\" means `relay attach KEY` then "
                 "`relay get KEY`. Update the brief (`relay brief`) and post a session entry (`relay session`) "
                 "at each phase end, and finish with /close, /close later or /close wait. The relay skill "
                 "has the details.")
    text = "\n".join(lines)
    if len(text) > cap:
        text = text[:cap - 60] + "\n… (truncated; run `relay context` for the rest)"
    return text


def group_files(files, roots=None):
    """{group folder: [file rows]}: by git repo when there is one, else by folder."""
    groups = {}
    for f in files:
        root = repo_root(f["path"])
        if not root:
            root = os.path.dirname(f["path"])
        groups.setdefault(root, []).append(f)
    return groups


def merge_files(rows):
    """Merge rows for the same path (a parent shows its phases' files)."""
    by = {}
    for r in rows:
        m = by.get(r["path"])
        if not m:
            by[r["path"]] = dict(r, kinds=list(r.get("kinds") or []))
            continue
        m["times"] = (m.get("times") or 0) + (r.get("times") or 0)
        for k in r.get("kinds") or []:
            if k not in m["kinds"]:
                m["kinds"].append(k)
        if (r.get("last_at") or "") > (m.get("last_at") or ""):
            m["last"], m["last_at"] = r.get("last"), r.get("last_at")
    return [by[k] for k in sorted(by)]


def format_get(d, all_sessions=False):
    t = d["ticket"]
    out = []
    head = t["key"] if not t.get("jira_key") else "%s (%s)" % (t["key"], t["auto_key"])
    out.append("# %s · %s" % (head, t["title"]))
    meta = "Project %s (%s) · %s" % (t["project"], t["project_name"], label(t["status"]))
    if d.get("parent"):
        meta += " · phase %s of %s %s" % ("?" if t.get("phase") is None else t["phase"], d["parent"]["key"],
                                           d["parent"]["title"])
    if t.get("children"):
        meta += " · parent of %d phases (status rolls up from them)" % t["children"]
    meta += " · updated %s by %s" % (t.get("updated"), t.get("updated_by"))
    out.append(meta)
    if t.get("aliases"):
        out.append("Also known as: " + ", ".join(t["aliases"]))
    if t.get("jira_url"):
        out.append("Jira: " + t["jira_url"])
    if d.get("shared"):
        out.append("Also linked to %s: %s" % (t.get("jira_key"), "; ".join(
            "%s \"%s\"" % (o["key"], o["title"]) for o in d["shared"])))
    if t.get("status") == "waiting" and t.get("need"):
        out.append("Waiting for Adam: " + t["need"])
    if t.get("next_step"):
        out.append("Next step: " + t["next_step"])
    if t.get("needs_wrapup"):
        out.append("FLAG: closed without wrap-up. Ask Adam whether to mark it done or carry on.")
    if t.get("archived"):
        out.append("Archived %s." % t["archived"])
    links = t.get("links") or {}
    if links:
        out.append("Links: " + " · ".join("%s %s" % (k, v) for k, v in sorted(links.items())))
    notes = d.get("new_notes") or []
    if notes:
        out.append("")
        out.append("## New notes from Adam (now marked seen)")
        for n in notes:
            out.append("- %s %s: %s" % (n["key"], n["at"], n["body"]))
    if d.get("parent"):
        out.append("")
        out.append("## Parent plan: %s %s" % (d["parent"]["key"], d["parent"]["title"]))
        out.append(d["parent"].get("brief") or "(no plan yet)")
    phases = d.get("phases") or []
    if phases:
        out.append("")
        out.append("## Phases")
        for p in phases:
            mark = " ← this ticket" if p["key"] == t["key"] else ""
            ph = p.get("phase")
            line = "%s. %s %s — %s%s" % ("-" if ph is None else ph, p["key"], p["title"], label(p["status"]), mark)
            if p.get("status") == "waiting" and p.get("need"):
                line += " (need: %s)" % p["need"]
            if p.get("archived"):
                line += " (archived)"
            out.append(line)
    out.append("")
    out.append("## %s" % ("Plan" if t.get("children") else "Brief"))
    out.append(t.get("brief") or "(empty: write one with `relay brief`)")
    sessions = d.get("sessions") or []
    out.append("")
    shown = sessions if all_sessions else sessions[:3]
    if not sessions:
        out.append("## Sessions (none yet)")
    elif all_sessions or len(sessions) <= 3:
        out.append("## Sessions (%d)" % len(sessions))
    else:
        out.append("## Sessions (last 3 of %d; --all for every one)" % len(sessions))
    for s in shown:
        head = "- %s → %s · %s" % (s.get("started"), s.get("ended") or "open", s.get("session_id"))
        if s.get("closed_by"):
            head += " · closed by " + s["closed_by"]
        if s.get("cwd"):
            head += " · " + s["cwd"]
        out.append(head)
        if s.get("summary"):
            out.append("  Summary: " + s["summary"].replace("\n", "\n  "))
        if s.get("open_items"):
            out.append("  Open: " + s["open_items"].replace("\n", "\n  "))
        if s.get("commits"):
            out.append("  Commits: " + ", ".join(s["commits"]))
        if s.get("prs"):
            out.append("  PRs: " + ", ".join(s["prs"]))
    files = merge_files(d.get("files") or [])
    out.append("")
    out.append("## Files (%d)" % len(files))
    for root, rows in sorted(group_files(files).items()):
        out.append(root + "/")
        for f in rows:
            rel = os.path.relpath(f["path"], root)
            out.append("  %s — %s ×%d · %s" % (rel, ", ".join(f.get("kinds") or []) or "?",
                                              f.get("times") or 1, f.get("last")))
    docs = d.get("docs") or []
    if docs:
        out.append("")
        out.append("## Docs")
        for doc in docs:
            out.append("- %s%s" % (doc["path"], " (%s)" % doc["label"] if doc.get("label") else ""))
    events = d.get("events") or []
    if events:
        out.append("")
        out.append("## Recent activity")
        for e in events:
            if e["kind"] == "status":
                body = "%s → %s" % (label(e.get("from")), label(e.get("to")))
            else:
                body = (e.get("body") or "").replace("\n", " ")
                if len(body) > 300:
                    body = body[:300] + "…"
            seen = ""
            if e["kind"] == "note" and e["actor"] == "adam":
                seen = " ✓ seen" if e.get("seen") else " (not picked up yet)"
            out.append("- %s %s %s: %s%s" % (e["at"], e["actor"], e["kind"], body, seen))
    return "\n".join(out)


def format_notes(notes):
    if not notes:
        return ""
    lines = ["# Relay: new note%s from Adam" % ("s" if len(notes) > 1 else "")]
    for n in notes:
        lines.append("- %s (%s): %s" % (n["key"], n["at"], n["body"]))
    lines.append("Adam wrote this in Relay while the session was running. Take it into account now; "
                 "if it changes the plan, say so and update the brief.")
    return "\n".join(lines)


def hook_json(event, text):
    return json.dumps({"hookSpecificOutput": {"hookEventName": event, "additionalContext": text[:CONTEXT_CAP]}})


# ---------------------------------------------------------------------------
# Ticket helpers
# ---------------------------------------------------------------------------

def norm_key(key):
    k = (key or "").strip().upper().rstrip(".")
    if not KEY_RE.match(k):
        raise RelayError("%r is not a ticket ID (like RLY-5 or WEB-R12)" % key)
    return k


def resolve(key):
    """One ticket for an ID, alias or Jira key. A Jira key shared by several
    tickets is refused, naming each ticket's own ID."""
    k = norm_key(key)
    rows = q(SQL_RESOLVE, {"key": k, "tz": TZ}) or []
    return pick_ticket(k, rows)


def full_target(args, sid):
    """target(), with every field resolve() gives (the session's ticket is looked up by id)."""
    if getattr(args, "key", None):
        return resolve(args.key)
    t = target(args, sid)
    rows = q(SQL_RESOLVE_ID, {"tid": t["id"], "key": "", "tz": TZ}) or []
    if not rows:
        raise RelayError("the session's ticket %s is no longer in Relay" % t.get("key"))
    return rows[0]


def pick_ticket(k, rows):
    if not rows:
        raise RelayError("no ticket %s" % k)
    if rows[0].get("own") or len(rows) == 1:
        return rows[0]
    raise RelayError("%s is linked to %d tickets: %s. Use the ticket's own ID." % (
        k, len(rows), "; ".join("%s \"%s\"" % (r["auto_key"], r["title"]) for r in rows)))


def target(args, sid):
    """The ticket a command acts on: --key, else this session's current ticket."""
    key = getattr(args, "key", None)
    if key:
        return resolve(key)
    cur = current_ticket(load_state(sid))
    if not cur:
        raise RelayError("no ticket attached to this session: pass --key KEY or run `relay attach KEY`")
    return cur


def remember(sid, ticket, cwd=None):
    """Record session -> ticket locally (the current ticket is the last one attached).

    Attaching starts new work, so it clears "closed": a session that ran /close
    and then attached another ticket is open again, and its SessionEnd hook
    flags that ticket if the window closes without /close."""
    def put(s):
        lst = [x for x in (s.get("tickets") or []) if x.get("id") != ticket["id"]]
        lst.append({"id": ticket["id"], "key": ticket["key"], "at": time.time()})
        s["tickets"] = lst
        s.setdefault("cwd", cwd or os.getcwd())
        s.pop("ended", None)
        s.pop("closed", None)
        s.pop("closed_at", None)
    return update_state(sid, put)


def read_text_arg(value, label_):
    if value == "-":
        data = sys.stdin.read()
        if not data.strip():
            raise RelayError("%s: nothing on stdin" % label_)
        return data
    return value


def do_attach(key, sid, cwd):
    v = common_vars(sid, cwd)
    # Resolve first, so a Jira key shared by several tickets is refused, not guessed.
    v["key"] = resolve(key)["auto_key"]
    t = q(SQL_ATTACH, v)
    if not t:
        raise RelayError("no ticket %s" % v["key"])
    remember(sid, t, cwd)
    roots = snapshot_targets(cwd, project={"key": t.get("project"), "paths": t.get("project_paths") or []})
    add_snapshots(sid, roots)
    return t


