        raise RelayError("no ticket %s" % v["key"])
    print(format_get(d, args.all))


def cmd_create(args):
    sid = session_id(args)
    cwd = norm(os.getcwd())
    if not args.title.strip():
        raise RelayError("the title is empty")
    status = args.status or "progress"
    if status == "waiting" and not args.need:
        raise RelayError("a waiting ticket needs --need \"what you need from Adam\"")
    parent = resolve(args.parent) if args.parent else None
    if parent and parent.get("parent_id"):
        raise RelayError("%s is a phase itself and can't have phases" % parent["key"])
    projects = q(SQL_PROJECTS) or []
    if args.project:
        proj = next((p for p in projects if p["key"] == args.project.upper()), None)
        if not proj:
            raise RelayError("no project %s" % args.project.upper())
        if parent and parent["project_id"] != proj["id"]:
            raise RelayError("a phase must be in its parent's project")
    elif parent:
        proj = next(p for p in projects if p["id"] == parent["project_id"])
    else:
        # The folder's project, else the Inbox. A session that knows the project passes --project.
        proj, _ = project_for(cwd, projects)
        if not proj:
            raise RelayError("no Inbox project (INB); pass --project KEY")
    attach = sid and not args.no_attach and not args.dry_run
    v = common_vars(sid if attach else "", cwd)
    v["by"] = actor(sid)
    brief = read_text_arg(args.brief, "--brief") if args.brief else ""
    v.update({"project_id": proj["id"], "title": args.title, "status": status, "need": args.need or "",
              "brief": brief, "next": args.next_step or "", "parent_id": (parent or {}).get("id", ""),
              "phase": str(args.phase) if args.phase is not None else ""})
    r = q(SQL_CREATE, v, dry_run=args.dry_run)
    if args.dry_run:
        print("Dry run: every check passed; this would create %s in %s%s. Nothing was saved." % (
            r["key"], proj["key"], " as phase %s of %s" % (r.get("phase"), parent["key"]) if parent else ""))
        return
    msg = "Created %s in %s" % (r["key"], proj["key"])
    if parent:
        msg += " as phase %s of %s" % (r.get("phase"), parent["key"])
    if attach:
        remember(sid, {"id": r["id"], "key": r["key"]}, cwd)
        add_snapshots(sid, snapshot_targets(cwd, project=proj))
        msg += "; attached to this session"
    print(msg + ".")


def cmd_attach(args):
    sid = session_id(args)
    if not sid:
        raise RelayError("no session id: run inside Claude Code, or pass --session")
    cwd = norm(os.getcwd())
